# Teracom Solutions website: configuration.
#
# Copy this file to .env.local for local work. In production these are set in
# Vercel (Project Settings, Environment Variables). Never commit real values.
# Variables starting NEXT_PUBLIC_ are sent to the browser; the rest are
# read on the server only.

# --- The site and its backend ----------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.teracomsolutions.com.au
# The website backend (teracom-website-backend). Locally: http://localhost:8000
BACKEND_API_URL=https://api.teracomsolutions.com.au
# Proves to the backend that a call comes from this website's server. Must
# exactly match the backend's WEBSITE_FRONTEND_SERVICE_TOKEN.
WEBSITE_FRONTEND_SERVICE_TOKEN=replace_with_a_long_random_string
# Where staff download collected documents from (default: the API address).
# NEXT_PUBLIC_RESOURCES_BASE_URL=https://api.teracomsolutions.com.au

# --- Payments (Stripe) ------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Bot protection (Cloudflare Turnstile) ---------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics --------------------------------------------------------------

# Defaults to the live site's own IDs when unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Salt for the anonymous visitor hash; falls back to the service token.
# VISIT_HASH_SALT=

# --- Zoho Books (Australia data centre) ------------------------------------

ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com.au
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.com.au/books/v3
ZOHO_CLIENT_ID=replace_me
ZOHO_CLIENT_SECRET=replace_me
ZOHO_REFRESH_TOKEN=replace_me
ZOHO_ORGANIZATION_ID=replace_me

# --- Feed import ------------------------------------------------------------

# Protects the supplier feed import route (app/api/admin/import-feed).
ADMIN_IMPORT_TOKEN=replace_with_a_long_random_string

# --- Rate limits (attempts per window, window in seconds) ------------------
# Each pair is optional; the code has a default for every one.

CHECKOUT_RATE_LIMIT_MAX_ATTEMPTS=10
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
LEADS_RATE_LIMIT_MAX_ATTEMPTS=5
LEADS_RATE_LIMIT_WINDOW_SECONDS=600
ADMIN_IMPORT_RATE_LIMIT_MAX_ATTEMPTS=20
ADMIN_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600
# REQUESTS_RATE_LIMIT_MAX_ATTEMPTS=  REQUESTS_RATE_LIMIT_WINDOW_SECONDS=
# COUPON_RATE_LIMIT_MAX_ATTEMPTS=  COUPON_RATE_LIMIT_WINDOW_SECONDS=
# ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=  ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# ADMIN_LOGIN_MFA_RATE_LIMIT_MAX_ATTEMPTS=  ADMIN_LOGIN_MFA_RATE_LIMIT_WINDOW_SECONDS=
# CUSTOMER_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=  CUSTOMER_LOGIN_RATE_LIMIT_WINDOW_SECONDS=
# CUSTOMER_SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=  CUSTOMER_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=
# CUSTOMER_RESET_RATE_LIMIT_MAX_ATTEMPTS=  CUSTOMER_RESET_RATE_LIMIT_WINDOW_SECONDS=
# CUSTOMER_RESET_CONFIRM_MAX_ATTEMPTS=  CUSTOMER_RESET_CONFIRM_WINDOW_SECONDS=

# Set by Vercel itself (NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA,
# VERCEL_GIT_COMMIT_MESSAGE): do not set these.